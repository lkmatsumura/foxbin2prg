            Endif

            ._Saved     = .T.
         Endwith

      Catch To loEx
         If This.n_Debug > 0 And _vfp.StartMode = 0
            Set Step On
         Endif

         Throw

      Finally
         loTable = .Null.
         Release I, loTable

      Endtry

      Return lnTable_Count
