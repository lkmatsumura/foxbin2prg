      *--------------------------------------------------------------------------------------------------------------
      LPARAMETERS tc_InputFile, tcRecompile, toModulo, toEx, tcOriginalFileName, tcLogFile, tcType

      LOCAL lcFileSpec, lnFileCount, laFiles(1,2), laExcluded(1) ;
