                  Case C_INDEX_F $ tcLine && Fin
                     Exit

                  Otherwise   && Propiedad de INDEX
                     *-- Estructura a reconocer:
                     *   <name>NOMBRE</name>
                     lcPropName  = Strextract( tcLine, '<', '>', 1, 0 )
                     lcValue     = Strextract( tcLine, '<' + lcPropName + '>', '</' + lcPropName + '>', 1, 0 )
                     .AddProperty( '_' + lcPropName, lcValue )
