      + [<memberdata name="juliantodatetime" display="julianToDateTime"/>] ;
      + [<memberdata name="isarrayelement" display="isArrayElement"/>] ;
      + [</VFPData>]

   *--
   MemVar_Name                 = ''
   MemVar_NameLength           = ''
   MemVar_Type                 = ''
   MemVar_Rows                 = ''
   MemVar_Cols                 = ''
   MemVar_Length               = ''
