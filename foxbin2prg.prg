         tcComment   = Substr(tcComment, 2, Len(tcComment) - 2)

         tcLine      = Rtrim(Left(tcLine, lnATC - 1 ), 0, Chr(9), Chr(0), ' ')
      Endif

      Return tcComment
   Endproc



