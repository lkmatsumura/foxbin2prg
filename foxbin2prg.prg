         TEXT TO tcCodigo ADDITIVE TEXTMERGE NOSHOW FLAGS 1+2 PRETEXT 1+2
                <<'ENDDEFINE'>>
                <<>>
         ENDTEXT
      Endif

      Return
   Endproc



