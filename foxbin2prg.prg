            .SpecialPropsFiles_Add( "getprops_optiongroup"        , "a_SpecialProps_Opg"    , "optiongroup"     )
            .SpecialPropsFiles_Add( "getprops_optiongroup_option" , "a_SpecialProps_Opb"    , "optionbutton"    )
