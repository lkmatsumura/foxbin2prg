            lcKeyName   = 'SHIFT+F8'

         Case Bitand(lnKeyVal, 0x115A) = 0x115A
            lcKeyName   = 'SHIFT+F7'

         Case Bitand(lnKeyVal, 0x1159) = 0x1159
            lcKeyName   = 'SHIFT+F6'

