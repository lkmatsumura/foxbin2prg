         Endif

         ._Procedure_Count   = ._Procedure_Count + 1
         Dimension ._Procedures( ._Procedure_Count )
         Dimension ._aProcNames( ._Procedure_Count )
         ._Procedures( ._Procedure_Count )   = toProcedure
