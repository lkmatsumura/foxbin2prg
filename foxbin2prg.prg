                  loCfgPass = loCFG
               ELSE
                  IF VARTYPE(tcCFG_File) = 'C' AND !EMPTY(tcCFG_File)
                     loCfgPass = tcCFG_File
                  ENDIF
               ENDIF
               lnCodError = .exportProjectTree(tc_InputFile, lcMirrorRoot, loCfgPass)

