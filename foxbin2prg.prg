         tc_FullPath = Justpath(tc_FullPath)
      Endif

      tc_FullPath = Addbs( tc_FullPath )

      If Len(tc_InputFile) > 1 ;
            AND Left(Ltrim(tc_InputFile),2) <> '\\' ;
