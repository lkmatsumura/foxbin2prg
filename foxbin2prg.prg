                              lo_CFG.l_ItemPerDBCCheck            = lo_CFG.l_ClassPerFileCheck
                              This.o_Host.writeLog( C_TAB + Justfname(lcConfigFile) + '  => ItemPerDBCCheck:          ' + Transform(lcValue) )
