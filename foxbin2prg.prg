                  Do Case
                  Case Empty( tcLine )
                     Loop

                  Case C_FIELD_ORDER_F $ tcLine   && Fin
                     Exit

                  Otherwise   && nombre del campo en el orden original
                     .n_Campos   = .n_Campos + 1
                     Dimension .a_Campos(.n_Campos, 2)
                     .a_Campos(.n_Campos, 1) = tcLine

                  Endcase
               Endfor
            Endwith && THIS
         Endif

      Catch To loEx
         If This.n_Debug > 0 And _vfp.StartMode = 0
