      *---------------------------------------------------------------------------------------------------
      * PARÁMETROS:               (v=Pasar por valor | @=Pasar por referencia) (!=Obligatorio | ?=Opcional) (IN/OUT)
      * taArray                   (@?    OUT) Array de conexiones
      * tnArray_Count             (@?    OUT) Cantidad de conexiones
      *---------------------------------------------------------------------------------------------------
   Endproc
Enddefine



