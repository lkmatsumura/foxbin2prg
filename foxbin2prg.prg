                           This.o_Host.writeLog( C_TAB + Justfname(lcConfigFile) + ' > DBC_Conversion_Support:     ' + Transform(lo_CFG.n_DBC_Conversion_Support) )
                        Endif

                     Case Left( laConfig(m.I), 23 ) == Lower('FKY_Conversion_Support:')
