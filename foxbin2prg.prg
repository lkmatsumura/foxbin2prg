   Procedure Init
      DoDefault()
      *--
      With This As CL_DBC_VIEW Of 'foxbin2prg.prg'
         .AddObject("_Fields", "CL_DBC_FIELDS_VW" )
         .AddObject("_Indexes", "CL_DBC_INDEXES_VW" )
