            tcDevInfo   = Stuff( tcDevInfo,  478, Len(._CompanyName), ._CompanyName)
            tcDevInfo   = Stuff( tcDevInfo,  733, Len(._FileDescription), ._FileDescription)
            tcDevInfo   = Stuff( tcDevInfo,  988, Len(._LegalCopyright), ._LegalCopyright)
