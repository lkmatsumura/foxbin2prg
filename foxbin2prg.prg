Define Class CL_COL_BASE As Collection
   #If .F.
      Local This As CL_COL_BASE Of 'foxbin2prg.prg'
   #Endif

   *-- Propiedades (Se preservan: COUNT, KEYSORT, NAME)
   **HIDDEN BASECLASS, CLASS, CLASSLIBRARY, COUNT, COMMENT ;
