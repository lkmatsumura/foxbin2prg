         toFoxBin2Prg.updateProcessedFile()


      Catch To loEx
         lnCodError  = loEx.ErrorNo
         toFoxBin2Prg.updateProcessedFile( 0, '', '', 'E1' )

         If This.n_Debug > 0 And _vfp.StartMode = 0
            Set Step On
         Endif

         Throw

      Finally
         Use In (Select(Juststem(This.c_OutputFile)))

      Endtry

      Return lnCodError
   Endproc


