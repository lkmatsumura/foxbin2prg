      #If .F.
         Local toProject As CL_PROJECT Of 'foxbin2prg.prg'
      #Endif
      LOCAL lcOutputFile

      lcOutputFile = Fullpath(This.c_OutputFile)

      Insert Into TABLABIN ;
         ( Name ;
         , Type ;
         , Timestamp ;
         , OUTFILE ;
         , HomeDir ;
         , SAVECODE ;
         , Debug ;
         , Encrypt ;
         , NOLOGO ;
         , CMNTSTYLE ;
         , OBJREV ;
