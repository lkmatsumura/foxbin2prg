                              This.o_Host.writeLog( C_TAB + Justfname(lcConfigFile) + '  => FormPerFileCheck          ' + Transform(lcValue) )
                           Endif
                        Endif

                     Case Left( laConfig(m.I), 15 ) == Lower('UseClassPerDir:')
                        lcValue = Alltrim( Substr( laConfig(m.I), 16 ) )
